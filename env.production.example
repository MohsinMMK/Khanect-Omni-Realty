# Copy to .env.production on the VPS (never commit .env.production).
# cp env.production.example .env.production

NODE_ENV=production
APP_VERSION=1.0.0

# Public URLs — must match your domain after DNS points to the VPS.
APP_BASE_URL=https://yourdomain.com
API_BASE_URL=https://yourdomain.com/api/v1
BETTER_AUTH_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
CRM_BASE_URL=https://yourdomain.com

# Compose / web
WEB_PORT=80
POSTGRES_DB=realestate_app
POSTGRES_USER=realestate
POSTGRES_PASSWORD=change_me_strong_postgres_password

# Production secrets (min 32 chars; enforced by @workspace/config)
BETTER_AUTH_SECRET=change_me_better_auth_secret_64_chars_minimum_value_here
ENCRYPTION_KEY=change_me_encryption_key_64_chars_minimum_value_here
ADMIN_API_KEY=change_me_admin_api_key_64_chars_minimum_value_here

# --- Embeddings (pick ONE mode) ---
#
# RECOMMENDED for 8 GB VPS (no local embedder RAM):
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024
#
# Alternative — self-hosted BGE base (add rag-embedder to compose; ~768-dim column):
# EMBEDDING_PROVIDER=local
# EMBEDDER_URL=http://rag-embedder:8080
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_DIMENSION=768
#
# Not recommended on 8 GB with full stack — BGE-M3 needs ~2–4 GB RAM alone:
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSION=1024

# Chat answers (OpenAI-compatible)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Platform
PLATFORM_STORE=postgres
RAG_INDEX_SYNC=false
BETTER_AUTH_ENABLED=true
LOG_LEVEL=info

# Meta channels (optional)
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
INSTAGRAM_MESSAGING_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=