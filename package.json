{
  "name": "khanect-omni-realty",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo run test --filter=api --filter=worker --filter=@workspace/config --filter=@workspace/core --filter=@workspace/db",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "smoke:phase1a-db": "pnpm --filter @workspace/db smoke:phase1a",
    "smoke:rag-pipeline": "node scripts/smoke-rag-pipeline.mjs",
    "smoke:bge-embedder": "node scripts/smoke-bge-embedder.mjs",
    "smoke:bge-embedder:docker": "scripts/smoke-bge-embedder-docker.sh",
    "check:openapi": "node scripts/check-openapi.mjs",
    "check:compose": "scripts/check-compose.sh"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  }
}
