# env.example
NODE_ENV=production
APP_VERSION=0.1.0
APP_BASE_URL=https://clientdomain.com
API_BASE_URL=https://clientdomain.com/api/v1
API_INTERNAL_BASE_URL=http://app:3000
VITE_API_BASE_URL=/api/v1
CRM_BASE_URL=https://crm.clientdomain.com
CORS_ORIGINS=https://clientdomain.com

POSTGRES_USER=realestate
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://realestate:change_me@postgres:5432/realestate_app
TWENTY_DATABASE_URL=postgresql://realestate:change_me@postgres:5432/twenty
REDIS_URL=redis://redis:6379

MAP_RENDERER=maplibre
MAP_TILE_URL=
MAP_STYLE_URL=
MAP_GEOCODING_PROVIDER=
MAP_GEOCODING_API_KEY=

BETTER_AUTH_URL=https://clientdomain.com
BETTER_AUTH_SECRET=change_me_64_chars
ENCRYPTION_KEY=change_me_32_bytes_base64

TWENTY_VERSION=v2.14.0
TWENTY_API_URL=https://crm.clientdomain.com
TWENTY_API_KEY=change_me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://clientdomain.com/api/oauth/google/callback
GMAIL_SEND_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://clientdomain.com/api/oauth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=change_me
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
INSTAGRAM_MESSAGING_ENABLED=false
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PUBLISHING_ENABLED=false

EMBEDDER_VERSION=0.1.0
EMBEDDING_MODEL=BAAI/bge-m3
LLM_PROVIDER=ollama
LLM_BASE_URL=http://llm-server:11434
LLM_MODEL=qwen3
LOCAL_AI_ENABLED=false

UPLOAD_DIR=/app/uploads
UPLOAD_TMP_DIR=/app/uploads/tmp
UPLOAD_QUARANTINE_DIR=/app/uploads/quarantine
MAX_IMAGE_UPLOAD_MB=15
MAX_PDF_UPLOAD_MB=25
MAX_FILES_PER_DRAFT=20
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=30000
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=info
