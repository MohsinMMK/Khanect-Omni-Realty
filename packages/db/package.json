{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @workspace/config build && pnpm --filter @workspace/core build",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "smoke:phase1a": "pnpm build && node scripts/smoke-phase1a.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "pretest": "pnpm --filter @workspace/config build && pnpm --filter @workspace/core build",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"drizzle.config.ts\"",
    "pretypecheck": "pnpm --filter @workspace/config build && pnpm --filter @workspace/core build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/config": "workspace:*",
    "@workspace/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  }
}
